{
  "name": "zmzai-lectern",
  "version": "0.6.1",
  "private": true,
  "description": "Lectern — Web / Desktop 同构的 Agent 工作台（Next.js 单页 + Electron 壳）",
  "main": "electron/main.cjs",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "port:free": "lsof -nP -tiTCP:3100 -sTCP:LISTEN | xargs kill -9 2>/dev/null; true",
    "dev": "pnpm run port:free && concurrently -k -n web,app -c cyan,magenta \"next dev -p 3100\" \"wait-on http://127.0.0.1:3100 && electron electron/main.cjs\"",
    "dev:web": "pnpm run port:free && next dev -p 3100",
    "dev:app": "wait-on http://127.0.0.1:3100 && electron electron/main.cjs",
    "framework:build": "pnpm --dir ../zmzai-framework build",
    "dev:fresh": "pnpm run framework:build && rm -rf .next && pnpm run dev",
    "dev:fresh:web": "pnpm run framework:build && rm -rf .next && pnpm run dev:web",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test scripts/release-validation.test.mjs scripts/signing-preflight.test.mjs scripts/upload-oss.source-test.mjs scripts/strip-standalone-source.source-test.mjs scripts/check-standalone-clean.source-test.mjs scripts/ui-e2e-gate.source-test.mjs electron/updater.source-test.cjs electron/web-server.source-test.cjs",
    "test:packaged": "node e2e/packaged-smoke.mjs",
    "test:task-groups-ui": "node e2e/task-groups-ui.mjs",
    "test:task-delivery-ui": "node e2e/task-delivery-ui.mjs",
    "test:conversation-ui": "node e2e/conversation-first-ui.mjs",
    "test:attachments-ui": "node e2e/attachments-ui.mjs",
    "test:clipboard-native": "node e2e/clipboard-native-ui.mjs",
    "test:workbench-ui": "node e2e/workbench-resize-ui.mjs",
    "test:touch-ui": "node e2e/touch-drag-ui.mjs",
    "test:message-search-ui": "node e2e/message-search-ui.mjs",
    "test:message-recovery-ui": "node e2e/message-recovery-ui.mjs",
    "test:pdf-preview-ui": "node e2e/pdf-preview-ui.mjs",
    "verify:release": "node scripts/release-validation.mjs release dist",
    "verify:public": "node scripts/verify-public-release.mjs",
    "verify:update-path": "node scripts/verify-update-path.mjs",
    "build:mac": "bash scripts/build-mac.sh",
    "build:win": "powershell -ExecutionPolicy Bypass -File scripts/build-win.ps1",
    "build:win:cross": "bash scripts/build-win-cross.sh",
    "build:win:cross:upload": "bash scripts/build-win-cross.sh --upload"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@tanstack/react-virtual": "^3.14.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zmzai/agent-framework": "file:vendor/zmzai-agent-framework-0.9.0.tgz",
    "@zmzai/theme": "^0.9.10",
    "electron-updater": "6.6.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.39.0",
    "mammoth": "^1.12.3",
    "next": "15.5.21",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "tailwindcss": "4.3.3",
    "web-tree-sitter": "0.25.8"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ali-oss": "^6.23.0",
    "concurrently": "^9.2.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "6.6.2",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.4",
    "yaml": "2.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "build": {
    "appId": "cloud.zmzai.lectern",
    "productName": "Lectern",
    "publish": {
      "provider": "generic",
      "url": "https://zmzai.oss-cn-beijing.aliyuncs.com/releases/harness/"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      ".next/standalone/**",
      "!**/.env",
      "!**/.env.*",
      "!.next/standalone/.next/cache/**",
      "!node_modules/**",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!**/*.ts",
      "!**/*.mts",
      "!**/*.cts",
      "!**/*.md",
      "!**/LICENSE*",
      "!**/*.scss",
      "!**/*.h",
      "!**/*.c",
      "!**/__tests__/**",
      "!**/*.test.js",
      "!**/*.spec.js"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/assets/**",
      "**/node-pty/prebuilds/**",
      "**/*.node",
      "**/*.dll"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lectern",
      "artifactName": "Lectern-Setup-${version}.${ext}"
    }
  }
}
